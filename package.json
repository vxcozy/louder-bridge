{
  "name": "louder-bridge",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "description": "Use a Work Louder Codex Micro with Claude, Hermes, and terminal agents in Ghostty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vxcozy/louder-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/vxcozy/louder-bridge/issues"
  },
  "homepage": "https://github.com/vxcozy/louder-bridge#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.mjs start",
    "doctor": "node src/cli.mjs doctor",
    "setup": "node scripts/setup-worker.mjs",
    "status": "node src/cli.mjs status",
    "uninstall": "node src/cli.mjs uninstall",
    "test": "node --test",
    "authorship:check": "node scripts/attribution-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:build:local": "LOUDER_LOCAL_SIGNING_IDENTITY='Louder Bridge Development' node scripts/build-release.mjs",
    "release:notarize": "node scripts/notarize-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "louderBridge": {
    "deviceProvider": {
      "id": "native-iokit-protocol",
      "support": "experimental",
      "protocolReference": {
        "name": "FreeMicro",
        "revision": "64258eb6cc3312a43f9f9f86d87e55e0b609ccc5",
        "license": "MIT",
        "url": "https://github.com/eliBenven/freemicro"
      }
    },
    "claudeNavigator": {
      "id": "claude-resume-url",
      "support": "experimental"
    },
    "claudeVoice": {
      "id": "claude-accessibility-dictation",
      "support": "experimental"
    },
    "hermesNavigator": {
      "id": "hermes-recent-session-shortcut",
      "support": "experimental"
    },
    "hermesVoice": {
      "id": "hermes-accessibility-dictation",
      "support": "experimental"
    },
    "ghosttyNavigator": {
      "id": "ghostty-applescript-terminal",
      "support": "experimental"
    },
    "ghosttyVoice": {
      "id": "ghostty-agent-aware-dictation",
      "support": "experimental"
    }
  }
}
